  "author": "Jay Sen <jaysen@apache.org>",
  "homepage": "https://super-schema.github.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/super-schema/super-schema.git"
  },
  "private": true,
  "engines": {
    "node": ">=20.9.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:corpus": "CORPUS=1 vitest run tests/integration/corpus",
    "test:e2e:raw": "playwright test",
    "test:e2e:smoke": "node scripts/e2e-phases.mjs smoke",
    "test:e2e:regression": "node scripts/e2e-phases.mjs regression",
    "test:e2e:nightly": "node scripts/e2e-phases.mjs nightly",
    "test:e2e:serial": "node scripts/e2e-phases.mjs serial",
    "test:e2e:visual": "node scripts/e2e-update-snapshots.mjs --check",
    "test:e2e:update-snapshots": "node scripts/e2e-update-snapshots.mjs",
    "test:e2e:release": "node scripts/e2e-release.mjs --tier nightly",
    "test:e2e:release:smoke": "node scripts/e2e-release.mjs --tier smoke",
    "db:generate": "prisma generate",
    "predev": "npm run db:generate && tsx scripts/db.ts ensure && npm run build:parser-worker",
    "prebuild": "npm run db:generate && npm run build:parser-worker",
    "build:parser-worker": "node scripts/build-parser-worker.mjs",
    "db:deploy": "tsx scripts/db.ts deploy",
    "db:name-conflicts": "tsx scripts/report-name-conflicts.ts",
    "db:flag-stale-sources": "tsx scripts/flag-stale-typespec-sources.ts",
    "db:migrate-typespec-source": "esbuild scripts/migrate-typespec-source.ts --bundle --platform=node --format=esm --packages=external --alias:server-only=./scripts/stubs/server-only.cjs --outfile=node_modules/.cache/migrate-typespec-source.mjs --log-level=warning && node node_modules/.cache/migrate-typespec-source.mjs",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx scripts/admin-create.mjs",
    "db:seed-events-demo": "esbuild scripts/seed-events-demo.ts --bundle --platform=node --format=esm --packages=external --alias:server-only=./scripts/stubs/server-only.cjs --outfile=node_modules/.cache/seed-events-demo.mjs --log-level=warning && node node_modules/.cache/seed-events-demo.mjs",
    "db:studio": "prisma studio",
    "gen:asyncapi-templates": "tsx scripts/generate-asyncapi-templates.ts"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.5",
