    "@tanstack/react-query": "^5.101.2",
    "@types/dagre": "^0.7.54",
    "@typespec/avro": "file:../typespec/packages/avro",
    "@typespec/java-pojo": "file:../typespec/packages/java-pojo",
    "@xyflow/react": "^12.10.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
