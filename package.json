    "next-intl": "^4.9.0",
    "next-themes": "^0.4.6",
    "openapi-sampler": "^1.7.6",
    "protobufjs": "^8.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@asyncapi/specs": "^6.11.1",
    "@playwright/test": "^1.59.1",
    "@superschema/typespec-enterprise": "file:vendor/typespec-enterprise",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typespec/bigquery": "file:../typespec/packages/bigquery",
    "@typespec/compiler": "^1.10.0",
    "@typespec/http-client-csharp": "^1.0.0-alpha.20260407.1",
    "@typespec/http-client-java": "^0.6.1",
    "@typespec/http-client-js": "^0.14.1",
    "@typespec/http-client-python": "^0.28.2",
    "@typespec/http-server-csharp": "^0.58.0-alpha.26",
    "@typespec/http-server-js": "^0.58.0-alpha.25",
    "@typespec/json-schema": "^1.10.0",
    "@typespec/openapi": "^1.10.0",
    "@typespec/openapi3": "^1.10.0",
    "@typespec/postgres": "file:../typespec/packages/postgres",
    "@typespec/protobuf": "^0.80.0",
    "@typespec/spanner": "file:../typespec/packages/spanner",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.2",
    "agentation": "^3.1.2",
    "axe-core": "^4.11.2",
    "dotenv": "^17.4.0",
    "esbuild": "^0.27.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "jsdom": "^29.0.1",
    "prisma": "^7.6.0",
    "shadcn": "^4.1.2",
    "tailwindcss": "^4",
