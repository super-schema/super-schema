// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String      @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  entities      Entity[]
  auditLogs     AuditLog[]
  gitConfigs    GitConfig[]
  roles         UserRole[]
  notifications Notification[]
  webhooks      WebhookEndpoint[] @relation("WebhookCreator")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// Schema Authoring Models
// ============================================================

enum EntityStatus {
  DRAFT
  ACTIVE
  DEPRECATED
  RETIRED
}

enum ApiScope {
  DOMAIN
  ENTITY
}

model Domain {
  id                   String                @id @default(cuid())
  name                 String                @unique
  slug                 String                @unique
  description          String                @default("")
  policyTemplate       Json?
  isSystem             Boolean               @default(false)
  entities             Entity[]
  modelDefinitions     ModelDefinition[]
  decoratorDefinitions DecoratorDefinition[]
  userRoles            UserRole[]
  sharedEnums          SharedEnum[]
  customScalars        CustomScalar[]
  unionTypes           UnionType[]
  services             ServiceDefinition[]
  interfaces           InterfaceDefinition[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@map("domains")
}

model Entity {
  id             String           @id @default(cuid())
  name           String
  slug           String
  domainId       String
  version        Int              @default(1)
  status         EntityStatus     @default(DRAFT)
  ownerId        String
  description    String           @default("")
  metadata       Json?
  parentEntityId String?
  fields         Field[]
  services       ServiceDefinition[] @relation("EntityServices")
  pullRequests   GitPullRequest[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  domain        Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  owner         User     @relation(fields: [ownerId], references: [id])
  parentEntity  Entity?  @relation("EntityInheritance", fields: [parentEntityId], references: [id])
  childEntities Entity[] @relation("EntityInheritance")

  @@unique([slug, domainId])
  @@unique([name, domainId])
  @@map("entities")
}

model ModelDefinition {
  id               String                 @id @default(cuid())
  name             String
  description      String                 @default("")
  domainId         String
  sourceFormat     String                 @default("typespec")
  sourceNamespace  String?
  extendsModelName String?
  metadata         Json?
  fields           ModelFieldDefinition[]
  domain           Domain                 @relation(fields: [domainId], references: [id], onDelete: Cascade)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([name, domainId])
  @@map("model_definitions")
}

model ModelFieldDefinition {
  id             String          @id @default(cuid())
  modelId        String
  name           String
  type           String
  precision      Int?
  scale          Int?
  nullable       Boolean         @default(true)
  isKey          Boolean         @default(false)
  description    String          @default("")
  aliases        String[]
  classification String?
  sortOrder      Int
  decorators     Json            @default("{}")
  model          ModelDefinition @relation(fields: [modelId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([modelId, name])
  @@map("model_field_definitions")
}

model DecoratorDefinition {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  signature   String   @default("")
  targetTypes String[]
  domainId    String
  domain      Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, domainId])
  @@map("decorator_definitions")
}

model Field {
  id             String   @id @default(cuid())
  entityId       String
  name           String
  slug           String   @default("")
  type           String
  precision      Int?
  scale          Int?
  nullable       Boolean  @default(true)
  isKey          Boolean  @default(false)
  fieldNumber    Int?
  description    String   @default("")
  aliases        String[]
  classification String?
  sortOrder      Int
  decorators     Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  conceptLinks FieldConceptLink[]

  @@unique([entityId, name])
  @@unique([entityId, slug])
  @@map("fields")
}

// ============================================================
// Business Concept Registry
// ============================================================

model BusinessConcept {
  id              String   @id @default(cuid())
  name            String   @unique  // "Customer Identifier", "Transaction Amount"
  domain          String   @default("Core")  // business domain grouping
  definition      String   @default("")  // human-readable definition
  synonyms        String[]  // ["cust_id", "customer_number", "CustomerNo"]
  canonicalType   String?  // the canonical logical type: "string", "decimal", etc.
  classification  String?  // default classification: PII, SENSITIVE, etc.
  tags            String[]  // ["financial", "identity", "temporal"]
  ownerId         String?
  fieldLinks      FieldConceptLink[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("business_concepts")
}

model FieldConceptLink {
  id        String @id @default(cuid())
  fieldId   String
  conceptId String
  confidence Float @default(1.0)  // 0.0-1.0, how strong the link is
  linkedBy  String?  // user who linked, or "auto" for AI-suggested
  createdAt DateTime @default(now())

  field     Field           @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  concept   BusinessConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([fieldId, conceptId])
  @@map("field_concept_links")
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  userId      String
  timestamp   DateTime @default(now())
  beforeState Json?
  afterState  Json?

  user User @relation(fields: [userId], references: [id])

  @@map("audit_log")
}

// ============================================================
// Git Integration Models (Epic 10)
// ============================================================

enum GitAuthMethod {
  SSH_KEY
  PERSONAL_ACCESS_TOKEN
  GITHUB_APP
}

enum GitSyncStatus {
  SUCCESS
  FAILED
  PENDING
}

enum PrReviewMode {
  ALWAYS
  BREAKING_ONLY
  NEVER
}

enum GitPrStatus {
  OPEN
  MERGED
  CLOSED
}

model GitConfig {
  id             String         @id @default(cuid())
  repositoryUrl  String
  branch         String         @default("main")
  basePath       String         @default("schemas/")
  authMethod     GitAuthMethod
  authCredential String
  prReviewMode   PrReviewMode   @default(BREAKING_ONLY)
  enabled        Boolean        @default(false)
  lastSyncAt     DateTime?
  lastSyncStatus GitSyncStatus?
  createdBy      String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  creator User @relation(fields: [createdBy], references: [id])

  @@map("git_config")
}

model GitPullRequest {
  id         String      @id @default(cuid())
  entityId   String
  versionId  String
  prUrl      String
  prNumber   Int
  branchName String
  status     GitPrStatus @default(OPEN)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@map("git_pull_requests")
}

// ============================================================
// RBAC & User Roles
// ============================================================

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  role      String
  domainId  String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain Domain? @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([userId, role, domainId])
  @@map("user_roles")
}

// ============================================================
// Classification Taxonomy
// ============================================================

model ClassificationLevel {
  id           String   @id @default(cuid())
  name         String   @unique
  displayColor String
  bgColor      String
  textColor    String
  description  String   @default("")
  sortOrder    Int      @default(0)
  isSystem     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("classification_levels")
}

// ============================================================
// Notifications
// ============================================================

enum NotificationType {
  APPROVAL_REQUEST
  APPROVAL_DECISION
  CHANGE_COMPLETE
  DRIFT_ALERT
  ANNOTATION_TAG
  ANNOTATION_REPLY
  COMPLIANCE_GAP
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String           @default("")
  entityId  String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

// ============================================================
// Webhooks
// ============================================================

model WebhookEndpoint {
  id        String            @id @default(cuid())
  url       String
  events    String[]
  secret    String
  active    Boolean           @default(true)
  createdBy String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deliveries WebhookDelivery[]

  creator User @relation("WebhookCreator", fields: [createdBy], references: [id])

  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id          String   @id @default(cuid())
  endpointId  String
  event       String
  payload     Json
  statusCode  Int?
  error       String?
  attempt     Int      @default(1)
  nextRetryAt DateTime?
  deliveredAt DateTime @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId])
  @@map("webhook_deliveries")
}

// ============================================================
// Governance & Approvals
// ============================================================

enum GovernanceStatus {
  PENDING
  APPROVED
  REJECTED
  AUTO_APPROVED
}

enum GovernanceDecision {
  APPROVE
  REJECT
}

model GovernanceRequest {
  id           String           @id @default(cuid())
  entityId     String
  entityName   String
  domainId     String?
  versionId    String?
  changeType   String
  severity     String
  status       GovernanceStatus @default(PENDING)
  impactReport Json?
  requestedBy  String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  approvals    GovernanceApproval[]

  @@index([status])
  @@map("governance_requests")
}

model GovernanceApproval {
  id         String             @id @default(cuid())
  requestId  String
  approverId String
  decision   GovernanceDecision
  comment    String?
  decidedAt  DateTime           @default(now())

  request GovernanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("governance_approvals")
}

// ============================================================
// Type Mapping Overrides
// ============================================================

model TypeMappingOverride {
  id              String   @id @default(cuid())
  sourceType      String
  targetFormat    String
  mappedType      String
  isLossy         Boolean  @default(false)
  lossDescription String?
  justification   String?
  approvedBy      String?
  entityId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([sourceType, targetFormat, entityId])
  @@map("type_mapping_overrides")
}

model LossyMappingAck {
  id           String   @id @default(cuid())
  entityId     String
  sourceType   String
  targetFormat String
  userId       String
  acknowledgedAt DateTime @default(now())

  @@unique([entityId, sourceType, targetFormat, userId])
  @@map("lossy_mapping_acks")
}

// ============================================================
// Emitter Configuration
// ============================================================

model EmitterConfig {
  id             String   @id @default(cuid())
  emitterName    String   @unique
  targetFormat   String
  version        String   @default("1.0.0")
  enabled        Boolean  @default(true)
  description    String   @default("")
  configOverrides Json?
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("emitter_configs")
}

// ============================================================
// Emission Tracking
// ============================================================

enum EmissionStatus {
  CURRENT
  STAGED
  BEHIND
}

model EmissionTargetStatus {
  id              String         @id @default(cuid())
  entityId        String
  target          String
  emittedVersion  Int?
  stagedVersion   Int?
  lastEmittedAt   DateTime?
  status          EmissionStatus @default(BEHIND)
  output          String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([entityId, target])
  @@map("emission_target_statuses")
}

// ============================================================
// Deployment Tracking
// ============================================================

enum DeploymentStatus {
  DEPLOYED
  STAGED
  UNKNOWN
}

model DeploymentRecord {
  id           String           @id @default(cuid())
  entityId     String
  target       String
  environment  String
  version      Int
  status       DeploymentStatus @default(DEPLOYED)
  driftReport  Json?
  isDrifted    Boolean          @default(false)
  deployedBy   String?
  deployedAt   DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([entityId, target, environment])
  @@map("deployment_records")
}

// ============================================================
// Shared Enums (standalone enum definitions)
// ============================================================

model SharedEnum {
  id          String   @id @default(cuid())
  name        String
  values      String[]
  description String   @default("")
  domainId    String
  domain      Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, domainId])
  @@map("shared_enums")
}

// ============================================================
// Custom Scalars
// ============================================================

model CustomScalar {
  id          String   @id @default(cuid())
  name        String
  baseType    String
  format      String?
  pattern     String?
  description String   @default("")
  domainId    String
  domain      Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, domainId])
  @@map("custom_scalars")
}

// ============================================================
// Union Types
// ============================================================

model UnionType {
  id          String   @id @default(cuid())
  name        String
  memberTypes String[]
  description String   @default("")
  domainId    String
  domain      Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, domainId])
  @@map("union_types")
}

// ============================================================
// API Service Definitions & Operations
// ============================================================

model ServiceDefinition {
  id          String      @id @default(cuid())
  name        String
  description String      @default("")
  basePath    String      @default("/")
  domainId    String
  scope       ApiScope    @default(DOMAIN)
  entityId    String?
  domain      Domain      @relation(fields: [domainId], references: [id], onDelete: Cascade)
  entity      Entity?     @relation("EntityServices", fields: [entityId], references: [id], onDelete: SetNull)
  operations  Operation[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([name, domainId])
  @@map("service_definitions")
}

model Operation {
  id          String               @id @default(cuid())
  serviceId   String
  name        String
  httpMethod  String
  httpPath    String
  description String               @default("")
  decorators  Json                 @default("{}")
  service     ServiceDefinition    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  parameters  OperationParameter[]
  responses   OperationResponse[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("operations")
}

model OperationParameter {
  id          String    @id @default(cuid())
  operationId String
  name        String
  type        String
  location    String
  required    Boolean   @default(true)
  description String    @default("")
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@map("operation_parameters")
}

model OperationResponse {
  id          String    @id @default(cuid())
  operationId String
  statusCode  Int
  type        String?
  description String    @default("")
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@map("operation_responses")
}

// ============================================================
// Interface Definitions (groups of operations)
// ============================================================

model InterfaceDefinition {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  domainId    String
  domain      Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  operationIds String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, domainId])
  @@map("interface_definitions")
}
