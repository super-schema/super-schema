// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String      @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  entities      Entity[]
  auditLogs     AuditLog[]
  gitConfigs    GitConfig[]
  roles         UserRole[]
  notifications Notification[]
  webhooks      WebhookEndpoint[] @relation("WebhookCreator")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// Schema Authoring Models
// ============================================================

enum EntityStatus {
  DRAFT
  ACTIVE
  DEPRECATED
  RETIRED
}

model Domain {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String   @default("")
  policyTemplate Json?
  isSystem       Boolean  @default(false)
  entities       Entity[]
  userRoles      UserRole[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("domains")
}

model Entity {
  id             String           @id @default(cuid())
  name           String
  domainId       String
  version        Int              @default(1)
  status         EntityStatus     @default(DRAFT)
  ownerId        String
  description    String           @default("")
  metadata       Json?
  fields         Field[]
  pullRequests   GitPullRequest[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  owner  User   @relation(fields: [ownerId], references: [id])

  @@unique([name, domainId])
  @@map("entities")
}

model Field {
  id             String   @id @default(cuid())
  entityId       String
  name           String
  type           String
  precision      Int?
  scale          Int?
  nullable       Boolean  @default(true)
  isKey          Boolean  @default(false)
  fieldNumber    Int?
  description    String   @default("")
  aliases        String[]
  classification String?
  sortOrder      Int
  decorators     Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, name])
  @@map("fields")
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  userId      String
  timestamp   DateTime @default(now())
  beforeState Json?
  afterState  Json?

  user User @relation(fields: [userId], references: [id])

  @@map("audit_log")
}

// ============================================================
// Git Integration Models (Epic 10)
// ============================================================

enum GitAuthMethod {
  SSH_KEY
  PERSONAL_ACCESS_TOKEN
  GITHUB_APP
}

enum GitSyncStatus {
  SUCCESS
  FAILED
  PENDING
}

enum PrReviewMode {
  ALWAYS
  BREAKING_ONLY
  NEVER
}

enum GitPrStatus {
  OPEN
  MERGED
  CLOSED
}

model GitConfig {
  id             String         @id @default(cuid())
  repositoryUrl  String
  branch         String         @default("main")
  basePath       String         @default("schemas/")
  authMethod     GitAuthMethod
  authCredential String
  prReviewMode   PrReviewMode   @default(BREAKING_ONLY)
  enabled        Boolean        @default(false)
  lastSyncAt     DateTime?
  lastSyncStatus GitSyncStatus?
  createdBy      String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  creator User @relation(fields: [createdBy], references: [id])

  @@map("git_config")
}

model GitPullRequest {
  id         String      @id @default(cuid())
  entityId   String
  versionId  String
  prUrl      String
  prNumber   Int
  branchName String
  status     GitPrStatus @default(OPEN)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@map("git_pull_requests")
}

// ============================================================
// RBAC & User Roles
// ============================================================

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  role      String
  domainId  String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain Domain? @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([userId, role, domainId])
  @@map("user_roles")
}

// ============================================================
// Classification Taxonomy
// ============================================================

model ClassificationLevel {
  id           String   @id @default(cuid())
  name         String   @unique
  displayColor String
  bgColor      String
  textColor    String
  description  String   @default("")
  sortOrder    Int      @default(0)
  isSystem     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("classification_levels")
}

// ============================================================
// Notifications
// ============================================================

enum NotificationType {
  APPROVAL_REQUEST
  APPROVAL_DECISION
  CHANGE_COMPLETE
  DRIFT_ALERT
  ANNOTATION_TAG
  ANNOTATION_REPLY
  COMPLIANCE_GAP
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String           @default("")
  entityId  String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

// ============================================================
// Webhooks
// ============================================================

model WebhookEndpoint {
  id        String            @id @default(cuid())
  url       String
  events    String[]
  secret    String
  active    Boolean           @default(true)
  createdBy String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deliveries WebhookDelivery[]

  creator User @relation("WebhookCreator", fields: [createdBy], references: [id])

  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id          String   @id @default(cuid())
  endpointId  String
  event       String
  payload     Json
  statusCode  Int?
  error       String?
  attempt     Int      @default(1)
  nextRetryAt DateTime?
  deliveredAt DateTime @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId])
  @@map("webhook_deliveries")
}

// ============================================================
// Governance & Approvals
// ============================================================

enum GovernanceStatus {
  PENDING
  APPROVED
  REJECTED
  AUTO_APPROVED
}

enum GovernanceDecision {
  APPROVE
  REJECT
}

model GovernanceRequest {
  id           String           @id @default(cuid())
  entityId     String
  entityName   String
  domainId     String?
  versionId    String?
  changeType   String
  severity     String
  status       GovernanceStatus @default(PENDING)
  impactReport Json?
  requestedBy  String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  approvals    GovernanceApproval[]

  @@index([status])
  @@map("governance_requests")
}

model GovernanceApproval {
  id         String             @id @default(cuid())
  requestId  String
  approverId String
  decision   GovernanceDecision
  comment    String?
  decidedAt  DateTime           @default(now())

  request GovernanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("governance_approvals")
}

// ============================================================
// Type Mapping Overrides
// ============================================================

model TypeMappingOverride {
  id              String   @id @default(cuid())
  sourceType      String
  targetFormat    String
  mappedType      String
  isLossy         Boolean  @default(false)
  lossDescription String?
  justification   String?
  approvedBy      String?
  entityId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([sourceType, targetFormat, entityId])
  @@map("type_mapping_overrides")
}

model LossyMappingAck {
  id           String   @id @default(cuid())
  entityId     String
  sourceType   String
  targetFormat String
  userId       String
  acknowledgedAt DateTime @default(now())

  @@unique([entityId, sourceType, targetFormat, userId])
  @@map("lossy_mapping_acks")
}

// ============================================================
// Emitter Configuration
// ============================================================

model EmitterConfig {
  id             String   @id @default(cuid())
  emitterName    String   @unique
  targetFormat   String
  version        String   @default("1.0.0")
  enabled        Boolean  @default(true)
  description    String   @default("")
  configOverrides Json?
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("emitter_configs")
}

// ============================================================
// Emission Tracking
// ============================================================

enum EmissionStatus {
  CURRENT
  STAGED
  BEHIND
}

model EmissionTargetStatus {
  id              String         @id @default(cuid())
  entityId        String
  target          String
  emittedVersion  Int?
  stagedVersion   Int?
  lastEmittedAt   DateTime?
  status          EmissionStatus @default(BEHIND)
  output          String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([entityId, target])
  @@map("emission_target_statuses")
}

// ============================================================
// Deployment Tracking
// ============================================================

enum DeploymentStatus {
  DEPLOYED
  STAGED
  UNKNOWN
}

model DeploymentRecord {
  id           String           @id @default(cuid())
  entityId     String
  target       String
  environment  String
  version      Int
  status       DeploymentStatus @default(DEPLOYED)
  driftReport  Json?
  isDrifted    Boolean          @default(false)
  deployedBy   String?
  deployedAt   DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([entityId, target, environment])
  @@map("deployment_records")
}
