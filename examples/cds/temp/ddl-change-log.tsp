// ================================================================================================
// DDL CHANGE LOG — Standalone metadata table
// ================================================================================================
//
// Metadata table in separate database (customer-data-store-metadata).
// Stores DDL change history generated by the harness pipeline.
// Not interleaved — standalone table.
//
// INSTANCE: customer-data-store
// DATABASE: customer-data-store-metadata
// TABLE_CATEGORY: TRANSACTIONAL
// JIRA: DTCDS-480
// ================================================================================================

namespace PayPal.CustomerDataStore.Metadata;

using PayPal.CustomerDataStore.Decorators;

@doc("Stores DDL changeset history generated by the harness pipeline. Located in the metadata database (customer-data-store-metadata), separate from the main CDS data plane.")
@tableCategory("TRANSACTIONAL")
@accountability("DTCDS-480", "dt-cp-identity-cds@paypal.com", "DT-CP-Identity-CDS")
@capacity(500000)
@dataProvenance("CDS - Control Plane", "API")
@dataResidency(false)
model DdlChangeLog {
  @doc("Change id of the changeset being applied.")
  @key
  @infosecClass("Class 4")
  @maxLength(100)
  change_id: string;

  @doc("Raw DDL changes generated by the harness pipeline.")
  @infosecClass("Class 4")
  @maxLength(2621440)
  ddl: string;

  @doc("Artifact creation timestamp.")
  @infosecClass("Class 4")
  @commitTimestamp
  time_created: utcDateTime;
}
