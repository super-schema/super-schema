exports[`stand-alone generator output is byte-identical to the pre-closure generator > entity without references, governance on and off > no-refs governance 1`] = `
"import "@superschema/typespec-enterprise";
import "@typespec/openapi";

@doc("An entity")
@TypeSpec.OpenAPI.extension("x-tags", #["core", "pii"])
model Customer {
  @key
  @doc("Identifier")
  id: string;
  @maxLength(80)
  @Enterprise.dataClassification(Enterprise.DataClassification.PII)
  email: string;
  age?: int32;
  tags: string[];
}
"
`;
