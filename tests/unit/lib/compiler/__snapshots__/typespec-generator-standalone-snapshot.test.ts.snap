exports[`stand-alone enum / shared type / union / alias shapes > are unchanged, governance on and off > shared emission 1`] = `
"namespace Support.Core;

scalar Money extends decimal;

enum Priority {
  low,
  high,
}

union Ident {
  string,
  int32,
}

alias Tags = string[];

enum Ticket_state {
  open,
  "in-progress",
}

enum Ticket_states {
  x,
  y,
}

@doc("An entity")
model Ticket {
  state: Ticket_state;
  key: Ident;
  states: Ticket_states[];
}
"
`;

