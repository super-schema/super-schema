# Merge these settings into the deployment environment or .env.local. Never commit actual credentials.
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_URL=https://schemas.example.com
AUTH_SECRET=
AUTH_PROVIDERS=oidc
AUTH_PROVIDER_OIDC_ISSUER=https://sso.example.com/realms/acme
AUTH_PROVIDER_OIDC_CLIENT_ID=super-schema
AUTH_PROVIDER_OIDC_CLIENT_SECRET=
AUTH_PROVIDER_OIDC_LABEL=Company SSO
AUTH_PROVIDER_OIDC_ALLOWED_DOMAINS=example.com
# Enable only for an issuer whose verified emails you trust, restricted to your organization's domains.
# Accounts must already exist in Super Schema; SSO does not grant roles or create accounts.
AUTH_PROVIDER_OIDC_LINK_EXISTING_USERS=0
# Register this exact redirect URI with the issuer:
# https://schemas.example.com/api/auth/callback/oidc
# Check without contacting the issuer or database:
# npm run auth:check -- --production
