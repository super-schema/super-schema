    family-names: Sen
    email: jaysen@apache.org
repository-code: "https://github.com/super-schema/super-schema"
url: "https://super-schema.github.io/"
license: Apache-2.0
version: 0.1.0
keywords:
  - schema management
  - data modeling
  - TypeSpec
  - JSON Schema
  - OpenAPI
  - Avro
  - Protobuf
  - AsyncAPI
  - data governance
