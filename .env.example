# ─── Database ─────────────────────────────────────────────────────────────────
# Provider: "pglite" (embedded PostgreSQL, zero-config default) or "postgresql".
DB_PROVIDER=pglite

# PGlite data directory (used when DB_PROVIDER=pglite). Default: ./data/pglite
# PGLITE_DATA_DIR=./data/pglite

# PostgreSQL connection (REQUIRED when DB_PROVIDER=postgresql):
# DB_PROVIDER=postgresql
# DATABASE_URL=postgresql://superschema:password@localhost:5432/superschema

# ─── Auth ─────────────────────────────────────────────────────────────────────
# The secret that signs every login (the session cookie) is the whole authentication boundary. Make one:  openssl rand -base64 32
# A server in PRODUCTION (NODE_ENV=production: `next start`, the Docker image) refuses to start with a secret shorter than 32
# characters or a known development value such as the one below; development and test accept anything. AUTH_SECRET is the same
# setting under the name Auth.js documents (it wins when both are set; an empty value counts as not set). Auth.js's AUTH_SECRET_1..3
# rotation is NOT supported: the middleware reads only these two names and fails closed without one. docs/auth-ops.md.
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000
# In production Auth.js rejects every request whose Host it does not trust ("UntrustedHost") unless AUTH_URL is set or the host is trusted.
# Behind a reverse proxy you control that sets the Host header, trust it:  AUTH_TRUST_HOST=true
# (Without a proxy, set AUTH_URL to the public origin instead.) Development and `next start` on localhost do not need it.
# AUTH_TRUST_HOST=true

# The first administrator. `npm run db:seed` creates admin@admin.com / admin as the global ADMIN ONLY when NODE_ENV is not "production".
# To seed a real administrator (any environment), set BOTH (the password is 12 to 72 bytes); setting only one stops the seed. Or run
# `npm run admin:create -- --email you@example.com` once (docs/auth-ops.md). Nothing makes a user an administrator because they registered first.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# Who may make an account: invite (the DEFAULT: an account is made by accepting an invitation link), open (anyone may register; the account has no
# role until an administrator assigns one) or closed (nobody registers). An unknown value is "invite". docs/auth-ops.md.
# AUTH_REGISTRATION=invite

# Sign-in is throttled per e-mail and per client address (5 failures in 15 minutes). The client address is taken from X-Forwarded-For ONLY when
# this is 1, so set it only behind a reverse proxy that sets that header itself and overwrites what the client sent; otherwise leave it unset.
# AUTH_TRUST_PROXY=1

# The REST API key: `Authorization: Bearer <key>` on /api/v1/*. Unset = the key authentication is off (a session still works, with the roles of the
# signed-in user). The key is a SERVICE principal: it acts in ONE tenant with ONE role.
#   API_KEY_TENANT_ID  the tenant it acts in (a tenant id; default: the default tenant, tenant_default). The content routes answer for that tenant only.
#   API_KEY_ROLE       VIEWER | AUTHOR | STEWARD | COMPLIANCE_OFFICER | ADMIN (default ADMIN, so integrations that existed before access control keep
#                      working). An ADMIN key is a PLATFORM administrator, as the key has always been (the webhook routes are platform items), but its
#                      schemas are confined to API_KEY_TENANT_ID. A key that only reads schemas should be VIEWER. A value that is not a role turns the
#                      key OFF (it never falls back to ADMIN). docs/auth-ops.md.
# API_KEY=
# API_KEY_TENANT_ID=tenant_default
# API_KEY_ROLE=ADMIN

# ─── Sign-in providers (optional) ────────────────────────────────────────────
# Local accounts (e-mail and password) are always available. An administrator can ADD identity providers Auth.js knows: google, github,
# microsoft-entra-id, okta, keycloak, and a generic OpenID Connect issuer (oidc). The default is none: no provider, no button.
# A provider only signs in people who ALREADY have an account (an administrator made it or invited them): nobody signs up through a provider.
# A mistake (an unknown name, a missing setting, a mistyped AUTH_PROVIDER_* name) is logged and ignored in development and stops a production
# server from starting. Full guide, redirect URIs and worked examples: docs/auth.md. Nothing in this repository has been tried against a real provider.
# AUTH_PROVIDERS=
#
# Per provider, with <KEY> the key upper-cased and `-` as `_` (GOOGLE, GITHUB, MICROSOFT_ENTRA_ID, OKTA, KEYCLOAK, OIDC). The redirect URI to register
# at the provider is {AUTH_URL}/api/auth/callback/<key> (docs/auth.md).
# AUTH_PROVIDER_<KEY>_CLIENT_ID=
# AUTH_PROVIDER_<KEY>_CLIENT_SECRET=
# AUTH_PROVIDER_<KEY>_ISSUER=                 required for microsoft-entra-id, okta, keycloak and oidc: an https URL (the tenant's, the realm's, ...)
# AUTH_PROVIDER_<KEY>_LABEL=                  button text; defaults to the provider's name; REQUIRED for oidc
# AUTH_PROVIDER_<KEY>_ALLOWED_DOMAINS=example.com,.example.org   e-mail domains that may sign in (a leading dot = every subdomain); unset = no limit
# AUTH_PROVIDER_<KEY>_LINK_EXISTING_USERS=1   1 lets a user who has an account but never signed in through this provider do so, matched by VERIFIED
#                                             e-mail. Off by default; read the risk in docs/auth.md before turning it on.
# Example (Google): AUTH_PROVIDERS=google, AUTH_PROVIDER_GOOGLE_CLIENT_ID=..., AUTH_PROVIDER_GOOGLE_CLIENT_SECRET=...

# ─── JSON Schema import: field data security classification ──────────────────
# A property carrying  "x-securityClassification": {"data_class": "class4", "data_category": "Intrinsic"}
# gets classification = data_class, with data_category kept next to it. All optional; shown with defaults.
# SCHEMA_CLASSIFICATION_EXTENSION_KEY=x-securityClassification
# SCHEMA_CLASSIFICATION_LEVEL_FIELD=data_class
# SCHEMA_CLASSIFICATION_CATEGORY_FIELD=data_category
# JSON object mapping the vendor level to an app level (default: identity), e.g. {"class4":"PII"}
# SCHEMA_CLASSIFICATION_VALUE_MAP={}

# ─── JSON Schema import: "From URL" git-host roots ───────────────────────────
# Git-host URLs are fetched with the SERVER's own `gh` credentials, so they are restricted by default.
# SCHEMA_IMPORT_GIT_MODE=restricted|any   (default restricted; unknown value = restricted)
# SCHEMA_IMPORT_GIT_SCOPES=owner,owner/repo   (comma-separated, case-insensitive; used only when restricted;
#                                              empty = git-host import disabled; applies to the root URL AND to every $ref)

# ─── Schema import: the size of a YAML document ──────────────────────────────
# The YAML parser alone costs seconds and about a gigabyte of memory for a 1.8 MB document, before any guard can run, so a YAML
# document is refused by its size before it is parsed ("YAML documents are limited to 512 KiB; convert to JSON for larger schemas").
# JSON is not affected (it is read with JSON.parse and keeps the importers' 2 MB limit).
# SCHEMA_IMPORT_MAX_YAML_BYTES=524288   (a positive whole number of bytes; anything else = the default, 512 KiB)

# ─── AI assistant: natural-language entity creation, field suggestions ───────
# A local or self-hosted LLM server. Nothing leaves your network: hosted providers (OpenAI, Anthropic ...) are not supported. Without a provider and a
# base URL the AI features are off (the wizard says "AI not configured"). An administrator can also set these under Admin > AI; what is saved there
# WINS over this file. Full guide: docs/ai-setup.md.
# AI_PROVIDER=ollama|vllm      vllm = any OpenAI-compatible server (vLLM, LiteLLM, llama.cpp server ...)
# AI_BASE_URL=http://localhost:11434   the server ROOT (a trailing /v1 is removed, as the clients add their own path)
# AI_MODEL=llama3              default llama3
# AI_API_KEY=                  optional bearer token for an endpoint that needs one. Env-only: never stored in the database or shown in the UI.
# When AI_BASE_URL is unset the provider's own standard name is used: OLLAMA_HOST (ollama; host[:port], http:// is assumed) or OPENAI_BASE_URL (vllm).
# OLLAMA_HOST=127.0.0.1:11434
# OPENAI_BASE_URL=http://localhost:8000/v1
